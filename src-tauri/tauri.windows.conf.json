{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Halo",
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "pacchetto/windows-hooks.nsh",
        "languages": [
          "Italian"
        ]
      }
    },
    "resources": {
      "pacchetto/windows-dipendenze.ps1": "dipendenze.ps1"
    }
  }
}
