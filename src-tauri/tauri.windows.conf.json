{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Halo",
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "pacchetto/windows-hooks.nsh",
        "languages": [
          "Italian"
        ]
      }
    },
    "resources": {
      "pacchetto/windows-dipendenze.ps1": "dipendenze.ps1",
      "risorse/realesrgan/realesrgan-ncnn-vulkan.exe": "realesrgan/realesrgan-ncnn-vulkan.exe",
      "risorse/realesrgan/vcomp140.dll": "realesrgan/vcomp140.dll",
      "risorse/realesrgan/vcomp140d.dll": "realesrgan/vcomp140d.dll",
      "risorse/realesrgan/models/realesrgan-x4plus.bin": "realesrgan/models/realesrgan-x4plus.bin",
      "risorse/realesrgan/models/realesrgan-x4plus.param": "realesrgan/models/realesrgan-x4plus.param",
      "risorse/realesrgan/models/realesrgan-x4plus-anime.bin": "realesrgan/models/realesrgan-x4plus-anime.bin",
      "risorse/realesrgan/models/realesrgan-x4plus-anime.param": "realesrgan/models/realesrgan-x4plus-anime.param",
      "risorse/realesrgan/LICENSE-Real-ESRGAN.txt": "realesrgan/LICENSE-Real-ESRGAN.txt",
      "risorse/realesrgan/LICENSE-ncnn-vulkan.txt": "realesrgan/LICENSE-ncnn-vulkan.txt",
      "risorse/realesrgan/PROVENIENZA.txt": "realesrgan/PROVENIENZA.txt"
    }
  }
}
